# Optional. GitHub Pages serves from /straw/; Vercel, Netlify and Cloudflare Pages
# serve from the domain root, so set this to / on those platforms.
VITE_BASE_PATH=/straw/
# VITE_BASE_PATH=/

# No API keys or secrets are required. All data is seeded locally and persisted
# in the browser via localStorage. See README.md for the architecture rationale.
